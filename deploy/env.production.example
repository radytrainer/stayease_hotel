# Copy to .env in the project folder on the server:  cp deploy/env.production.example .env
# Then fill in the values marked "change". Never commit .env.

# Address people type in the browser. No trailing slash.
PUBLIC_URL=http://3.107.7.2
# Caddy site address. ":80" = plain HTTP on the IP. With a domain pointed at the server,
# set SITE_ADDRESS=stayease.example.com and PUBLIC_URL=https://stayease.example.com for automatic HTTPS.
SITE_ADDRESS=:80

POSTGRES_DB=stayease
POSTGRES_USER=stayease
# change: generate with  openssl rand -base64 24
POSTGRES_PASSWORD=

# Empty = production data only. Set to "local" to load the demo hotels and demo accounts
# (for a presentation server). Decide before the first start: switching later needs a fresh database.
SPRING_PROFILES_ACTIVE=

# First administrator, created on first start when no demo data is loaded. Password: 12+ characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional: online card payments. Webhook URL: ${PUBLIC_URL}/api/v1/payments/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: booking emails.
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_API_URL=https://api.resend.com/emails

# Optional: hotel photo uploads (an S3 bucket and an IAM user's access key with read/write on it).
S3_BUCKET=
S3_REGION=ap-southeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

KHR_PER_USD=4067
KHR_RATE_PUBLISHED_ON=2026-10-16

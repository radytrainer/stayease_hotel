{$SITE_ADDRESS::80} {
	encode zstd gzip

	# API (including /api/v1/payments/webhooks/stripe) goes to Spring Boot; everything else to Next.js.
	handle /api/* {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}
